# =============================================================================
# Veridis Dev — Landing Page — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values before running locally.
# All variables here are required for production unless marked (optional).
#
# NEXT_PUBLIC_* variables are bundled into the client-side JavaScript.
# Do NOT put secrets in NEXT_PUBLIC_* variables.
# =============================================================================


# -----------------------------------------------------------------------------
# Email — Resend
# https://resend.com → API Keys
# Used by /api/contact to send contact form submissions.
# -----------------------------------------------------------------------------

# Server-only | required
# Your Resend API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-only | required
# The "from" address for outgoing emails. Must be a verified domain in Resend.
# Default during development: onboarding@resend.dev
RESEND_FROM_EMAIL=hola@veridisdev.com

# Server-only | required
# The inbox that receives contact form submissions.
RESEND_TO_EMAIL=team@veridisdev.com


# -----------------------------------------------------------------------------
# Rate Limiting — Upstash Redis
# https://console.upstash.com → Redis → Connect → REST API
# Used by /api/contact: 10 requests per IP per hour (sliding window).
# -----------------------------------------------------------------------------

# Server-only | required
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io

# Server-only | required
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token-here


# -----------------------------------------------------------------------------
# Error Tracking — Sentry
# https://sentry.io → Project Settings → Client Keys (DSN)
# Configured in Sprint 5. Required for production; optional locally.
# -----------------------------------------------------------------------------

# Client-exposed | required for production
# The DSN (Data Source Name) that routes errors to your Sentry project.
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX

# Server-only | required for production (optional locally)
# Used by the Sentry webpack plugin to upload source maps on build.
# https://sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-only | required for source map uploads
# Your Sentry organization slug (found in Settings → General).
SENTRY_ORG=your-sentry-org-slug

# Server-only | required for source map uploads
# Your Sentry project slug (found in Project Settings → General).
SENTRY_PROJECT=your-sentry-project-slug


# -----------------------------------------------------------------------------
# CMS — Sanity
# https://sanity.io/manage → Select project
# Configured in Sprint 4. Drives the /blog route and BlogPreview component.
# -----------------------------------------------------------------------------

# Client-exposed | required
# Found in sanity.io/manage → Project → Project ID.
NEXT_PUBLIC_SANITY_PROJECT_ID=xxxxxxxxx

# Client-exposed | required
# The Sanity dataset to query. Use "production" for the live site.
NEXT_PUBLIC_SANITY_DATASET=production

# Client-exposed | required
# The Sanity Content Lake API version to pin requests to (ISO date).
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only | optional
# A read-only API token for fetching draft content in preview mode.
# sanity.io/manage → API → Tokens → Add API token (Viewer role).
# Leave empty unless you implement draft preview.
SANITY_API_READ_TOKEN=


# -----------------------------------------------------------------------------
# Demo Credentials — Portfolio Projects
# These are FAKE credentials for demo accounts in portfolio projects.
# Exposed as NEXT_PUBLIC_* so they can be rotated without code changes.
# Never put real user credentials here.
# -----------------------------------------------------------------------------

# Budokan SKIF — https://budokan-app.vercel.app
# Sensei role
NEXT_PUBLIC_DEMO_BUDOKAN_USER=
NEXT_PUBLIC_DEMO_BUDOKAN_PASS=
# Karateca role
NEXT_PUBLIC_DEMO_BUDOKAN_KARATECA_USER=
NEXT_PUBLIC_DEMO_BUDOKAN_KARATECA_PASS=

# BarberOS — https://barberos-os.vercel.app
# Admin role
NEXT_PUBLIC_DEMO_BARBEROS_ADMIN_USER=admin@barberos.app
NEXT_PUBLIC_DEMO_BARBEROS_ADMIN_PASS=demo1234
# Staff role
NEXT_PUBLIC_DEMO_BARBEROS_STAFF_USER=staff@barberos.app
NEXT_PUBLIC_DEMO_BARBEROS_STAFF_PASS=demo1234

# Trucking CRM — https://trucking-crm-one.vercel.app
# Admin role
NEXT_PUBLIC_DEMO_TRUCKING_ADMIN_USER=admin@truckingcrm.app
NEXT_PUBLIC_DEMO_TRUCKING_ADMIN_PASS=demo1234
# Vendor role
NEXT_PUBLIC_DEMO_TRUCKING_VENDOR_USER=vendor@truckingcrm.app
NEXT_PUBLIC_DEMO_TRUCKING_VENDOR_PASS=demo1234


# -----------------------------------------------------------------------------
# Analytics — Plausible
# https://plausible.io → Sites → Add site
# Configured in Sprint 5. Required for production; leave empty locally.
# -----------------------------------------------------------------------------

# Client-exposed | required for production
# Your site domain as registered in Plausible (no protocol, no trailing slash).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=veridisdev.com
